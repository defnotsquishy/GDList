rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function account() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function activeAccount() {
      return signedIn() && account().banned != true;
    }

    function isAdmin() {
      return activeAccount() && account().role in ['admin', 'owner'];
    }

    function isOwner() {
      return activeAccount() && account().role == 'owner';
    }

    function verifiedAccount() {
      return activeAccount() && request.auth.token.email_verified == true;
    }

    function reviewIdentityUnchanged(before, after) {
      return after.get('reviewedBy', null) == before.get('reviewedBy', null)
        && after.get('reviewedAt', null) == before.get('reviewedAt', null)
        && after.get('reviewerName', null) == before.get('reviewerName', null);
    }

    function claimIdentityUnchanged(before, after) {
      return after.get('reviewClaimedBy', null) == before.get('reviewClaimedBy', null)
        && after.get('reviewClaimedAt', null) == before.get('reviewClaimedAt', null);
    }

    function reviewerNameMatchesAccount(name) {
      return name in [
        account().get('displayName', ''),
        account().get('username', '')
      ];
    }

    function hasNoReviewerIdentity(data) {
      return !data.keys().hasAny([
        'reviewedBy', 'reviewerId', 'reviewerName', 'reviewerEmail',
        'reviewClaimedBy', 'acceptedBy', 'acceptedByName'
      ]);
    }

    // Levels keep `victors` (snapshot objects) in lockstep with `victorIds`
    // (plain list of uids). Rules cannot iterate objects, so the uid list is
    // what lets non-admins prove they only added/removed THEIR OWN entry.
    function victorIdsOf(data) {
      return data.get('victorIds', []);
    }

    function victorsInLockstep(data) {
      return victorIdsOf(data).size() == data.get('victors', []).size();
    }

    function coreVictorFieldsOnly(before, after) {
      return after.diff(before).affectedKeys()
        .hasOnly(['victors', 'victorIds', 'victoryCount', 'updatedAt']);
    }

    function victorFieldsOnly(before, after) {
      return after.diff(before).affectedKeys()
        .hasOnly(['victors', 'victorIds', 'victoryCount', 'position', 'points', 'updatedAt']);
    }

    // Non-admin append: exactly one uid added and it must be the caller's.
    // Every pre-existing victor object must survive untouched and the new
    // (last) object must belong to the caller.
    function addsOwnVictorOnly(before, after) {
      return coreVictorFieldsOnly(before, after)
        && victorsInLockstep(before)
        && victorsInLockstep(after)
        && after.get('victors', []).size() == before.get('victors', []).size() + 1
        && victorIdsOf(after).size() == victorIdsOf(before).size() + 1
        && victorIdsOf(after).hasAll(victorIdsOf(before))
        && victorIdsOf(after).hasOnly(victorIdsOf(before).concat([request.auth.uid]))
        && !victorIdsOf(before).hasAny([request.auth.uid])
        && after.get('victoryCount', 0) == before.get('victoryCount', 0) + 1
        && after.get('victors', []).hasAll(before.get('victors', []))
        && after.get('victors', [])[after.get('victors', []).size() - 1].get('userId', '') == request.auth.uid;
    }

    // Non-admin removal: every remaining uid existed before, the caller's uid
    // is fully gone, and only caller-owned entries disappeared. Survivor
    // objects must be byte-identical. Community levels may reset
    // position/points once they lose their last victor.
    function removesOwnVictorsOnly(before, after) {
      let removedCount = before.get('victors', []).size() - after.get('victors', []).size();
      return victorFieldsOnly(before, after)
        && victorsInLockstep(before)
        && victorsInLockstep(after)
        && removedCount > 0
        && victorIdsOf(after).hasOnly(victorIdsOf(before))
        && victorIdsOf(before).hasOnly(victorIdsOf(after).concat([request.auth.uid]))
        && !victorIdsOf(after).hasAny([request.auth.uid])
        && before.get('victors', []).hasAll(after.get('victors', []))
        && (after.get('victoryCount', 0) == before.get('victoryCount', 0) - removedCount
          || (before.get('victoryCount', 0) < removedCount && after.get('victoryCount', 0) == 0))
        && (after.get('victors', []).size() > 0
          ? (after.get('position', 0) == before.get('position', 0)
            && after.get('points', 0) == before.get('points', 0))
          : (after.get('position', 0) == 0
            && after.get('points', 0) == 0
            && before.get('type', '') == 'community'));
    }

    match /users/{userId} {
      allow read: if true;

      allow create: if isSelf(userId)
        && request.resource.data.keys().hasOnly([
          'username', 'usernameLower', 'displayName', 'avatarURL', 'role',
          'banned', 'stats', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.role == 'user'
        && request.resource.data.banned == false
        && request.resource.data.stats.totalPoints == 0
        && request.resource.data.stats.mainPoints == 0
        && request.resource.data.stats.communityPoints == 0
        && request.resource.data.stats.mainCompletions == 0
        && request.resource.data.stats.communityCompletions == 0
        && request.resource.data.username.matches('^[a-zA-Z0-9_-]{3,20}$')
        && request.resource.data.usernameLower.matches('^[a-z0-9_-]{3,20}$')
        && existsAfter(/databases/$(database)/documents/usernames/$(request.resource.data.usernameLower))
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.usernameLower)).data.uid == userId;

      // Role/ban/developer changes are owner-only. Stats are admin-only or
      // self-decrements only (a user can never raise their own points).
      // Profile fields and sync stamps are self-service.
      allow update: if (isOwner()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['role', 'updatedAt'])
          && request.resource.data.role in ['user', 'admin', 'owner'])
        || (isOwner()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['banned', 'updatedAt'])
          && request.resource.data.banned is bool)
        || (isOwner()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['isDeveloper', 'updatedAt'])
          && request.resource.data.isDeveloper is bool)
        || (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['stats', 'updatedAt']))
        || (isSelf(userId) && activeAccount()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['stats', 'updatedAt'])
          && request.resource.data.stats.totalPoints <= resource.data.stats.totalPoints
          && request.resource.data.stats.mainPoints <= resource.data.stats.mainPoints
          && request.resource.data.stats.communityPoints <= resource.data.stats.communityPoints
          && request.resource.data.stats.mainCompletions <= resource.data.stats.mainCompletions
          && request.resource.data.stats.communityCompletions <= resource.data.stats.communityCompletions)
        || (isSelf(userId) && activeAccount()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'displayName', 'avatarURL', 'bio', 'country',
            'aredlSync', 'gdlSync', 'pointercrateSync', 'updatedAt'
          ]));

      allow delete: if isSelf(userId) || isOwner();
    }


    match /usernames/{username} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.usernameLower == username
        && request.resource.data.username.matches('^[a-zA-Z0-9_-]{3,20}$')
        && !exists(/databases/$(database)/documents/usernames/$(username));
      allow update: if false;
      allow delete: if isOwner() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    match /staff/{userId} {
      allow read: if true;
      allow create, update: if isOwner();
      allow delete: if isOwner() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    match /levels/{levelId} {
      allow read: if true;

      // Regular users may only auto-create placeholder docs during the AREDL
      // sync; every other create is an admin action.
      allow create: if isAdmin()
        || (signedIn()
          && request.resource.data.type == 'main'
          && request.resource.data.autoCreated == true
          && request.resource.data.createdVia == 'aredl_sync');

      allow update: if isAdmin()
        || addsOwnVictorOnly(resource.data, request.resource.data)
        || removesOwnVictorsOnly(resource.data, request.resource.data);

      allow delete: if isAdmin();
    }

    match /completions/{completionId} {
      allow read: if true;

      // Users may only write records attributed to themselves; admins may
      // create completions on behalf of submitters during review.
      allow create: if isAdmin()
        || (signedIn()
          && request.resource.data.userId == request.auth.uid
          && hasNoReviewerIdentity(request.resource.data));

      allow update: if isAdmin()
        || (signedIn()
          && resource.data.userId == request.auth.uid
          && request.resource.data.userId == request.auth.uid
          && hasNoReviewerIdentity(request.resource.data));

      allow delete: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
    }

    match /submissions/{submissionId} {
      allow create: if verifiedAccount()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.reviewedBy == null
        && request.resource.data.reviewedAt == null
        && !request.resource.data.keys().hasAny([
          'reviewerName', 'reviewClaimedBy', 'reviewClaimedAt'
        ]);

      // Players may inspect only their pending submission. Reviewer identity is
      // stored on reviewing/resolved submissions and remains admin-only.
      allow read: if isAdmin()
        || (isSelf(resource.data.userId) && resource.data.status == 'pending');

      // Enforce the review state machine. Claims and final attribution must
      // always belong to the authenticated admin performing the transition.
      allow update: if (isAdmin()
        && request.resource.data.userId == resource.data.userId
        && (
          (resource.data.status == 'pending'
            && request.resource.data.status == 'pending'
            && reviewIdentityUnchanged(resource.data, request.resource.data)
            && claimIdentityUnchanged(resource.data, request.resource.data))
          ||
          (resource.data.status == 'pending'
            && request.resource.data.status == 'reviewing'
            && request.resource.data.reviewClaimedBy == request.auth.uid
            && request.resource.data.reviewClaimedAt == request.time
            && reviewIdentityUnchanged(resource.data, request.resource.data))
          ||
          (resource.data.status == 'reviewing'
            && resource.data.reviewClaimedBy == request.auth.uid
            && (
              (request.resource.data.status == 'reviewing'
                && request.resource.data.reviewClaimedBy == request.auth.uid
                && request.resource.data.reviewClaimedAt == resource.data.reviewClaimedAt
                && reviewIdentityUnchanged(resource.data, request.resource.data))
              ||
              (request.resource.data.status == 'pending'
                && request.resource.data.reviewClaimedBy == null
                && request.resource.data.reviewClaimedAt == null
                && reviewIdentityUnchanged(resource.data, request.resource.data))
              ||
              (request.resource.data.status in ['approved', 'rejected']
                && request.resource.data.reviewClaimedBy == null
                && request.resource.data.reviewClaimedAt == null
                && request.resource.data.reviewedBy == request.auth.uid
                && request.resource.data.reviewedAt == request.time
                && reviewerNameMatchesAccount(request.resource.data.reviewerName))
            ))
          ||
          (resource.data.status in ['approved', 'rejected']
            && request.resource.data.status == resource.data.status
            && reviewIdentityUnchanged(resource.data, request.resource.data)
            && claimIdentityUnchanged(resource.data, request.resource.data))
        ))
        // A player may reopen their own rejected submission in place (e.g.
        // with a fresh video). Deterministic submission ids make this the only
        // way to retry after a rejection; it is equivalent to creating a new
        // submission, which they could do anyway.
        || (verifiedAccount()
          && isSelf(resource.data.userId)
          && resource.data.status == 'rejected'
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.status == 'pending'
          && request.resource.data.reviewedBy == null
          && request.resource.data.reviewedAt == null
          && !request.resource.data.keys().hasAny([
            'reviewerName', 'reviewClaimedBy', 'reviewClaimedAt'
          ]));

      allow delete: if isAdmin()
        || (isSelf(resource.data.userId) && resource.data.status == 'pending');
    }

    match /notifications/{notificationId} {
      // Only admins create notifications (submission outcomes), so users
      // cannot spam other accounts.
      allow create: if isAdmin() && request.resource.data.userId is string;
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'updatedAt']);
      allow delete: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
    }

    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.status == 'open';
      // Report content may contain PII and proof links; owner-eye only, the
      // same threshold the ManageReports page enforces.
      allow read, update, delete: if isOwner();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /tags/{tagId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /changelog/{entryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
